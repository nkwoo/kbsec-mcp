# KB증권 OpenAPI 필수 인증 정보 (KB증권 개발자센터에서 발급)
KBSEC_APP_KEY=
KBSEC_APP_SECRET=

# 선택 설정 (기본값을 쓰려면 비워두거나 주석 처리)
# KBSEC_BASE_URL=https://developer.kbsec.com:32484
# KBSEC_TIMEOUT_SECONDS=10

# 실거래 안전장치: 주문 접수/정정/취소 도구(14개)는 기본적으로 차단됩니다.
# 실제 매매를 허용하려면 아래 줄의 주석을 해제하고 true로 설정하세요.
# KBSEC_ENABLE_TRADING=false
